{
  "name": "orbit-hop",
  "version": "0.1.0",
  "private": true,
  "description": "Orbit Hop — Ronda 32. Reglas compartidas teléfono/servidor, cliente canvas y validador.",
  "type": "module",
  "scripts": {
    "dev": "node tools/build.mjs --serve",
    "build": "node tools/build.mjs",
    "build:worker": "node tools/build.mjs --worker",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "golden": "node --import tsx tools/golden.ts"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "@types/node": "^24.0.0"
  }
}
